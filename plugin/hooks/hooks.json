{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-guess-gate/prompt.sh",
            "statusMessage": "근거 게이트",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-guess-gate/pre.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "근거 게이트"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/test-integrity/pre.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "테스트 무결성 게이트"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/project-guard/pre.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "프로젝트 가드"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/done-gate/pre.sh",
            "shell": "bash",
            "timeout": 660,
            "statusMessage": "완료 게이트"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-guess-gate/stop.sh",
            "statusMessage": "근거 게이트",
            "shell": "bash",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/done-gate/stop.sh",
            "shell": "bash",
            "timeout": 240,
            "statusMessage": "완료 게이트"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-guess-gate/stop.sh",
            "statusMessage": "근거 게이트",
            "shell": "bash",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/done-gate/post.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "완료 게이트"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-guess-gate/bashres.sh",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/repo-profile/session.sh",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "저장소 프로필"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NGG_STATE=\"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-guess-gate/bashres.sh",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
